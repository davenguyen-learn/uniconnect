	"item": [
		{
			"name": "0. Health & Observability",
			"item": [
				{
					"name": "Health Check & Cold-Start Latency Probe",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test('Database is healthy', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.status).to.eql('ok');",
									"    pm.expect(jsonData.db).to.eql('healthy');",
									"});",
									"pm.test('Latency and Observability Timing Header present', function () {",
									"    pm.response.to.have.header('X-Process-Time');",
									"    console.log('Server Process Time: ' + pm.response.headers.get('X-Process-Time'));",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/health",
							"host": ["{{baseUrl}}"],
							"path": ["health"]
						},
						"description": "Kiểm tra tình trạng server, database connectivity và đo thời gian phản hồi (Cold start probe)."
					}
				}
			]
		},
